# Copy to .env (read automatically by docker compose). All optional —
# you can also set these from the dashboard ⚙️ Settings instead.

# Enables AI resume tailoring
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Enables Indeed + Naukri results via JSearch (free key at
# rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
JSEARCH_API_KEY=

# Enables scraping JS-heavy boards like Naukri via Firecrawl (firecrawl.dev)
FIRECRAWL_API_KEY=

# Comma-separated allowlist for the frontend origin (Vercel URL). Default: *
CORS_ORIGINS=
